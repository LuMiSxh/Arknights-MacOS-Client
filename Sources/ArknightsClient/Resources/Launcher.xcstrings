{
  "sourceLanguage": "en",
  "strings": {
    "launcher.artwork.accessibility": {
      "comment": "Accessibility label for the launcher background artwork",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arknights-Grafik"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arknights artwork"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.dialog.cancel": {
      "comment": "Cancel action",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.document.changelog": {
      "comment": "Title of the bundled changelog",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungsprotokoll"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changelog"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.document.license": {
      "comment": "Title of the bundled project license",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MPL-2.0-Lizenz"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MPL-2.0 License"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.document.notices": {
      "comment": "Title of bundled third-party notices",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweise zu Drittanbieter-Software"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Third-Party Notices"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.document.unavailable": {
      "comment": "Fallback when a bundled document cannot be loaded",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dokument ist in diesem Build nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document is unavailable in the current build."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.cannotCreateFile": {
      "comment": "Installer cannot create its temporary file; path follows",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäre Datei konnte nicht erstellt werden: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create temporary file: %@"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.cannotEncodeAppIcon": {
      "comment": "Selected image cannot become app icon",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Bild konnte nicht in ein App-Symbol umgewandelt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected image could not be converted into an app icon."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.cannotSetAppIcon": {
      "comment": "macOS refused app icon update",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS konnte das App-Symbol nicht aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS refused to update the app icon."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.diskCapacityUnavailable": {
      "comment": "Installation preflight cannot determine available disk capacity",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der verfügbare Speicherplatz konnte vor der Installation nicht ermittelt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available disk space could not be determined before installation."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.checksumMismatch": {
      "comment": "CRC check failed; file, actual checksum, expected checksum follow",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die CRC64-Prüfung für %@ ist fehlgeschlagen (%@, erwartet %@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CRC64 check for %@ failed (%@, expected %@)."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.conflictingManifestPaths": {
      "comment": "Two game manifest paths conflict; both paths follow",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widersprüchliche Pfade im Spielmanifest: %@ und %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conflicting paths in game manifest: %@ and %@"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.downloadResponse": {
      "comment": "Download returned an HTTP status; path then status follow",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download für %@ gab HTTP %@ zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download for %@ returned HTTP %@."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.downloadedSizeMismatch": {
      "comment": "Downloaded file has wrong byte size; path, actual and expected byte counts follow",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat %@ Bytes statt %@ Bytes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has %@ bytes instead of %@."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.duplicateManifestPath": {
      "comment": "Game manifest includes a duplicate path",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelter Pfad im Spielmanifest: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate path in game manifest: %@"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.gameNotInstalled": {
      "comment": "Arknights executable was not found; path follows",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arknights.exe wurde nicht gefunden: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arknights.exe was not found: %@"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.insufficientDiskSpace": {
      "comment": "Required and available disk space follow",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arknights benötigt etwa %@ freien Speicher, aber es sind nur %@ verfügbar. Gib Speicher frei und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arknights needs about %@ free, but only %@ is available. Free up space and try again."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.intelTranslationUnavailable": {
      "comment": "Rosetta cannot start Wine",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS konnte die Intel-basierte Wine-Laufzeit nicht starten. Prüfe, ob Rosetta 2 installiert ist, starte deinen Mac neu und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS could not start the Intel-based Wine runtime. Check that Rosetta 2 is installed and restart your Mac before trying again."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.intelTranslationUnsupported": {
      "comment": "macOS version no longer supports Wine Rosetta requirement",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese macOS-Version unterstützt die allgemeine Intel-Übersetzung nicht mehr, die die gebündelte Wine-Laufzeit benötigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This macOS version no longer supports the general Intel translation required by the bundled Wine runtime."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.invalidCustomImage": {
      "comment": "Selected custom image is unsupported; path follows",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählte Datei ist kein unterstütztes Bild: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected file is not a supported image: %@"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.invalidManifestPath": {
      "comment": "Unsafe game manifest path",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsicherer Pfad im Spielmanifest: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsafe path in game manifest: %@"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.invalidPresetImage": {
      "comment": "Preset image is unsupported or unsafe; URL follows",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Preset-Grafik ist kein unterstütztes Bild oder hat unsichere Abmessungen: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The preset asset is not a supported image or has unsafe dimensions: %@"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.invalidRemoteAsset": {
      "comment": "Remote asset URL was refused",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht unterstützte Remote-Asset-URL abgelehnt: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refused an unsupported remote asset URL: %@"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.invalidResponse": {
      "comment": "Yostar server sent invalid response",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Yostar-Server hat eine ungültige Antwort zurückgegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yostar's server returned an invalid response."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.missingConfiguration": {
      "comment": "Game configuration has not loaded",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Spielkonfiguration wurde noch nicht geladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current game configuration has not been loaded yet."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.remoteContentTooLarge": {
      "comment": "Remote host and size limit follow",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote-Inhalte von %@ haben das Limit von %@ überschritten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote content from %@ exceeded the %@ limit."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.rosettaDisabled": {
      "comment": "macOS Legacy Game Test Mode blocks Rosetta; command stays technical",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der macOS-Modus Legacy Game Test Mode deaktiviert die von Wine benötigte Rosetta-Übersetzung. Führe \"sudo game-test-tool disable\" im Terminal aus, starte deinen Mac neu und prüfe anschließend erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Legacy Game Test Mode disables the Rosetta translation required by Wine. Run \"sudo game-test-tool disable\" in Terminal, restart your Mac, then check again."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.rosettaMissing": {
      "comment": "Rosetta required; command stays technical",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta 2 wird benötigt, um die gebündelte Wine-Laufzeit zu starten. Installiere es mit \"softwareupdate --install-rosetta --agree-to-license\" im Terminal und prüfe anschließend erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta 2 is required to run the bundled Wine runtime. Install it by running \"softwareupdate --install-rosetta --agree-to-license\" in Terminal, then check again."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.gameCompatibility": {
      "comment": "Game helper compatibility setup failed; technical details are written to logs",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kompatibilitätsanpassungen der Spieldateien konnten nicht abgeschlossen werden. Repariere die Spieldateien und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Game-file compatibility setup could not be completed. Repair the game files and try again."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.runtimeConfiguration": {
      "comment": "Windows runtime setup failed; technical reason follows",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Windows-Laufzeit konnte nicht eingerichtet werden: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Windows runtime could not be configured: %@"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.runtimeExited": {
      "comment": "Windows runtime exit status and log path follow",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Windows-Laufzeit wurde mit Status %@ beendet. Details: %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Windows runtime exited with status %@. See %@."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.runtimeWindowTimeout": {
      "comment": "Game did not show a window in time",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arknights hat innerhalb von 90 Sekunden kein Fenster geöffnet. Prüfe das Wine-Protokoll und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arknights did not open a window within 90 seconds. Check the Wine log and try again."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.server": {
      "comment": "Yostar API code and unmodified message follow",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Yostar-API-Fehler %@: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yostar API error %@: %@"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.symbolicLink": {
      "comment": "Installer refused symlink in destination; path follows",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Spiel-Installer hat einen symbolischen Link im Zielordner abgelehnt: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game installer refused a symbolic link in its destination: %@"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.unsafeTemporaryFile": {
      "comment": "Installer refused unsafe temporary file; path follows",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Installer hat eine temporäre Datei abgelehnt, die keine reguläre Datei ist oder mehrere Hardlinks hat: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installer refused a non-regular or multiply linked temporary file: %@"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.error.wineRuntimeMissing": {
      "comment": "Compatible Wine runtime is missing",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine kompatible Windows-Laufzeit gefunden. Verwende einen Build mit Wine + DXMT."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No compatible Windows runtime found. Use a build that bundles Wine + DXMT."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.filePicker.choose": {
      "comment": "Generic file picker confirmation action",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auswählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.filePicker.gameIcon": {
      "comment": "Title for game icon picker",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiel-Symbol auswählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a game icon"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.filePicker.installDirectory": {
      "comment": "Title for install directory picker",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installationsort für Arknights auswählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose where to install Arknights"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.filePicker.launcherArtwork": {
      "comment": "Title for launcher artwork picker",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Launcher-Grafik auswählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose launcher artwork"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.filePicker.launcherIcon": {
      "comment": "Title for launcher icon picker",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Launcher-Symbol auswählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an app icon"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.filePicker.locateInstallation": {
      "comment": "Title for existing game folder picker",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner mit Arknights.exe auswählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the folder containing Arknights.exe"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.filePicker.useFolder": {
      "comment": "Existing game folder picker confirmation action",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner verwenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Folder"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.popup.done": {
      "comment": "Dismiss popup action",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.popup.notice": {
      "comment": "Generic official notice title",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notice"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.update.busy": {
      "comment": "Launcher update safety message while game or maintenance is active",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Launcher-Update ist während einer aktiven Operation nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launcher updates are unavailable during an active operation."
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.update.title": {
      "comment": "Custom launcher update modal title",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Launcher-Update"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launcher Update"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.update.version": {
      "comment": "Version shown in the launcher update modal; version follows",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.update.checking": {
      "comment": "Launcher update check in progress",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Updates wird gesucht…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking for updates…"
          }
        }
      },
      "extractionState": "manual"
    },
    "launcher.update.available": {
      "comment": "Launcher update is available",
      "localizations": {
        "de": {
