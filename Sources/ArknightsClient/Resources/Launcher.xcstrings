    "launcher.rosetta.confirmation.message": {
      "comment": "Explanation before starting Apple's Rosetta installer",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta 2 ist Apple-Systemsoftware, mit der dieser Apple-Silicon-Mac die gebündelte Intel-basierte Wine-Laufzeit ausführen kann. Beim Fortfahren wird Apples Softwareupdate gestartet und die Rosetta-Lizenz von Apple akzeptiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta 2 is Apple system software that lets this Apple silicon Mac run the bundled Intel-based Wine runtime. Continuing runs Apple’s software update tool and accepts Apple’s Rosetta license."
          }
        }
      },
      "extractionState": "manual"
    },
