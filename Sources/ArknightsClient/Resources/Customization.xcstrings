        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Game"
          }
        }
      }
    },
    "customization.iconPreview.launcher.detail": {
      "comment": "Launcher icon style explanation",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Launcher-Stil"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launcher style"
          }
        }
      }
    },
    "customization.iconPreview.launcher.title": {
      "comment": "Launcher icon style label",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Launcher"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launcher"
          }
        }
      }
    },
    "customization.iconPreview.loading": {
      "comment": "Loading state while rendering the generated icon previews",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau wird geladen…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading preview…"
          }
        }
      }
    },
    "customization.iconPreview.pair.accessibilityLabel": {
      "comment": "Accessibility label for the paired launcher and game icon preview",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau für Launcher- und Spielsymbol"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launcher and game icon previews"
          }
        }
      }
    },
    "customization.iconPreview.pair.unavailable": {
      "comment": "Accessibility label when generated icon previews cannot be rendered",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbolvorschau nicht verfügbar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Icon previews unavailable"
          }
        }
      }
    },
    "customization.iconPreview.subtitle": {
      "comment": "Generated icon preview explanation",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Operator wird auf beide Symbole angewendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your operator is applied to both icons."
          }
        }
      }
    },
    "customization.iconPreview.title": {
      "comment": "Generated icon preview title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Generierte Symbolstile"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
