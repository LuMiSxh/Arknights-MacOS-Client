{
  "sourceLanguage": "en",
  "strings": {
    "customization.gallery.action.previewStyles": {
      "comment": "Open generated launcher and game icon style preview",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stile ansehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview Styles"
          }
        }
      }
    },
    "customization.gallery.applying": {
      "comment": "Progress state while applying a selected gallery item",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird angewendet…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying…"
          }
        }
      }
    },
    "customization.gallery.artwork.empty": {
      "comment": "Empty state when no artwork matches the gallery search",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine passenden Hintergründe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching artwork"
          }
        }
      }
    },
    "customization.gallery.artwork.loading": {
      "comment": "Loading state while fetching official wallpaper choices",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offizielle Hintergründe werden geladen…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading official wallpapers…"
          }
        }
      }
    },
    "customization.gallery.artwork.searchPlaceholder": {
      "comment": "Artwork gallery search field placeholder",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergründe suchen…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search artwork…"
          }
        }
      }
    },
    "customization.gallery.artwork.subtitle": {
      "comment": "Artwork gallery explanation",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Hintergrund für den Launcher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a background for the launcher."
          }
        }
      }
    },
    "customization.gallery.artwork.title": {
      "comment": "Artwork gallery title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrundgalerie"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Artwork Gallery"
          }
        }
      }
    },
    "customization.gallery.operator.applyHelp": {
      "comment": "Accessibility help for applying an operator to the launcher and game icons; operator name is supplied content",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ für beide Dock-Symbole verwenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use %1$@ for both Dock icons"
          }
        }
      }
    },
    "customization.gallery.operator.empty": {
      "comment": "Empty state when no operators match the gallery search",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine passenden Operatoren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching operators"
          }
        }
      }
    },
    "customization.gallery.operator.loading": {
      "comment": "Loading state while fetching operator choices",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Operatoren werden geladen…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading operators…"
          }
        }
      }
    },
    "customization.gallery.operator.searchPlaceholder": {
      "comment": "Operator gallery search field placeholder",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Operatoren suchen…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search operators…"
          }
        }
      }
    },
    "customization.gallery.operator.subtitle": {
      "comment": "Operator gallery explanation",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Operator für beide Dock-Symbole."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one operator for both Dock icons."
          }
        }
      }
    },
    "customization.gallery.operator.title": {
      "comment": "Operator gallery title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Operator auswählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an Operator"
          }
        }
      }
    },
    "customization.gallery.search.label": {
      "comment": "Accessibility label for the current gallery search field",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Galerie durchsuchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search gallery"
          }
        }
      }
    },
    "customization.gallery.search.suggestionSelect": {
      "comment": "Accessibility hint for a gallery search suggestion button that fills the exact item title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auswählen und Suchtext übernehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select and use this exact title in the search"
          }
        }
      }
    },
    "customization.gallery.wallpaper.applyHelp": {
      "comment": "Accessibility help for applying a wallpaper; wallpaper title is supplied content",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ als Launcher-Hintergrund verwenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use %1$@ as the launcher background"
          }
        }
      }
    },
    "customization.gallery.wallpaper.fallbackTitle": {
      "comment": "Fallback title for an official wallpaper without a supplied title; argument is its one-based position",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrundbild %lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallpaper %lld"
          }
        }
      }
    },
    "customization.gallery.wallpaper.filter.all": {
      "comment": "Wallpaper category filter choice that shows every wallpaper",
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Alle Arten" } },
        "en": { "stringUnit": { "state": "translated", "value": "All Types" } }
      }
    },
    "customization.gallery.wallpaper.filter.label": {
      "comment": "Accessibility label for the wallpaper category filter",
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Hintergrundart" } },
        "en": { "stringUnit": { "state": "translated", "value": "Wallpaper type" } }
      }
    },
    "customization.gallery.wallpaper.type.celebration": {
      "comment": "Wallpaper category for anniversaries, celebrations, and livestreams",
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Feier" } },
        "en": { "stringUnit": { "state": "translated", "value": "Celebration" } }
      }
    },
    "customization.gallery.wallpaper.type.commemorative": {
      "comment": "Wallpaper category for follower and other commemorative artwork",
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Gedenken" } },
        "en": { "stringUnit": { "state": "translated", "value": "Commemorative" } }
      }
    },
    "customization.gallery.wallpaper.type.holiday": {
      "comment": "Wallpaper category for seasonal holidays",
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Feiertag" } },
        "en": { "stringUnit": { "state": "translated", "value": "Holiday" } }
      }
    },
    "customization.gallery.wallpaper.type.story": {
      "comment": "Wallpaper category for story and uncategorized artwork",
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Story" } },
        "en": { "stringUnit": { "state": "translated", "value": "Story" } }
      }
    },
    "customization.iconPreview.game.detail": {
      "comment": "Game icon style explanation",
      "extractionState": "manual",
      "localizations": {
