    "settings.installation.winePrefix.detail": {
      "comment": "Wine prefix destructive setting description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die gesamte Wine-Umgebung einschließlich gespeicherter Yostar-, Google-, Apple- und Facebook-Anmeldungen. Spieldateien bleiben unverändert; alles andere wird beim nächsten Start neu aufgebaut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the entire Wine environment, including saved Yostar, Google, Apple, and Facebook logins. Game files are untouched; everything else rebuilds on the next launch."
          }
        }
      }
    },
    "settings.installation.winePrefix.delete.detail": {
      "comment": "Delete Wine prefix confirmation description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wirst du von jeder im eingebetteten Browser gespeicherten Anmeldung abgemeldet. Spieldateien bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This signs you out of every login saved in the embedded browser. Game files are untouched."
          }
        }
      }
    },
    "settings.installation.wineSetup": {
      "comment": "Wine setup destructive setting",
      "extractionState": "manual",
