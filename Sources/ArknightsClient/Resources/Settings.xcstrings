            "state": "translated",
            "value": "Dafür wird Apples Werkzeug gamepolicyctl benötigt. Es ist nur in der vollständigen Xcode-App enthalten, nicht in den Command Line Tools. Installiere Xcode aus dem App Store, um es zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This requires Apple's gamepolicyctl tool, which only ships inside the full Xcode app, not the Command Line Tools. Install Xcode from the App Store to use it."
          }
        }
      }
    },
