    "settings.installation.wineSynchronization": {
      "comment": "Wine thread synchronization setting",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine-Thread-Synchronisierung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine Thread Synchronization"
          }
        }
      }
    },
    "settings.installation.wineSynchronization.detail": {
      "comment": "Wine thread synchronization setting description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuert, wie Wine auf Windows-Thread-Wartevorgänge abbildet. MSYNC verwendet die Mach-Synchronisierung von macOS und lieferte in unseren Tests gleichmäßigere Frame-Zeiten. ESYNC verwendet den älteren ereignisbasierten Wine-Pfad und bleibt der Kompatibilitäts-Fallback. Gilt ab dem nächsten Start."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls how Wine translates Windows thread waits. MSYNC uses macOS Mach synchronization and gave steadier frame pacing in our tests. ESYNC uses Wine's older event-based path and remains the compatibility fallback. Applies on the next launch."
          }
        }
      }
    },
