    "home.recovery.repair": {
      "comment": "Repair installed game files after a recoverable failure",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reparieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repair"
          }
        }
      }
    },
    "home.recovery.repair.confirm": {
      "comment": "Confirmed action that starts a full game-file repair",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reparatur starten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Repair"
          }
        }
      }
    },
    "home.recovery.repair.detail": {
      "comment": "Repair confirmation detail explaining verification and download cost",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Spieldateien dieser Region werden geprüft. Fehlende oder beschädigte Dateien werden erneut heruntergeladen; dies kann viel Datenvolumen benötigen. Launcher-Einstellungen und das Wine-Prefix bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every game file for this region will be checked. Missing or damaged files will be downloaded again and may use substantial data. Launcher settings and the Wine prefix are preserved."
          }
        }
      }
    },
    "home.recovery.repair.title": {
      "comment": "Title of the confirmation shown before a full game-file repair",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spieldateien reparieren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repair game files?"
          }
        }
      }
    },
    "home.recovery.retry": {
      "comment": "Retry the exact failed launcher operation",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
