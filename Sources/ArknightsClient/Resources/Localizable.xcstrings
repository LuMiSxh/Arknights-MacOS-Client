    "onboarding.welcome.compatibility.unavailable": {
      "comment": "Intel compatibility unavailable guidance",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS konnte keinen Intel-Testprozess starten. Starte deinen Mac neu und prüfe erneut. Besteht das Problem weiter, füge einem Fehlerbericht das Launcher-Protokoll bei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS could not start an Intel test process. Restart your Mac, then check again. If the problem remains, include the launcher log in a bug report."
          }
        }
      }
    },
    "onboarding.welcome.compatibility.unsupported": {
      "comment": "Unsupported Intel compatibility guidance",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese macOS-Version bietet die allgemeine Intel-Übersetzung nicht mehr, die die gebündelte Wine-Laufzeit benötigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This macOS version no longer provides the general Intel translation required by the bundled Wine runtime."
          }
        }
      }
    },
    "onboarding.welcome.compatibility.waiting": {
