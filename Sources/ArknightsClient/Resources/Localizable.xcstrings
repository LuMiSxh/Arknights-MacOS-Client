    "home.action.install.help": {
      "comment": "Install game action help; region is Global, Japan, or Korea",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offizielle PC-Dateien für %1$@ herunterladen und überprüfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download and verify the official %1$@ PC files"
          }
        }
      }
    },
    "home.action.pause": {
      "comment": "Pause download action",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        }
      }
    },
    "home.action.pause.help": {
      "comment": "Pause download action help",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download pausieren; er wird später mit den vorhandenen Teildateien fortgesetzt"
