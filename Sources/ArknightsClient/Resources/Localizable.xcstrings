    "onboarding.finish.community.detail": {
      "comment": "Community project disclaimer",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arknights Client ist ein inoffizieller Community-Launcher. Er ist nicht mit Hypergryph oder Yostar verbunden, wird von ihnen weder befürwortet noch unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arknights Client is an unofficial community launcher. It is not affiliated with, endorsed by, or supported by Hypergryph or Yostar."
          }
        }
      }
    },
    "onboarding.finish.community.support": {
      "comment": "Yostar support guidance",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wende dich bei Problemen mit Konto, Zahlung oder Spieldienst stattdessen an den Yostar-Support."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For account, payment, or game-service issues, contact Yostar support instead."
