    "onboarding.welcome.compatibility.gameTestMode": {
      "comment": "Legacy Game Test Mode recovery guidance",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Legacy Game Test Mode von macOS deaktiviert Rosetta, das die gebündelte Wine-Laufzeit benötigt. Deaktiviere den Testmodus und starte deinen Mac neu:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Legacy Game Test Mode disables Rosetta, which the bundled Wine runtime requires. Disable the test mode, then restart your Mac:"
