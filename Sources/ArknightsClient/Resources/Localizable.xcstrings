    "onboarding.extras.subtitle": {
      "comment": "Updates and audio setup subtitle",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Prüfungen suchen nur nach neuen Versionen. Downloads beginnen weiterhin erst, wenn du sie auswählst – außer der Installation, die diese Einrichtung bereits gestartet hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic checks only look for new versions. Downloads still begin when you choose them, except for the installation already started by this setup."
          }
        }
      }
    },
