      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Details anzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Details"
          }
        }
      }
    },
    "home.recovery.openTroubleshooting": {
      "comment": "Open the website version of the troubleshooting page for a launcher error code",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Website öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open on Website"
          }
        }
