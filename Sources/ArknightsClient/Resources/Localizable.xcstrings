    "onboarding.welcome.status.updateDetail": {
      "comment": "Update required guidance",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere den neueren Launcher und öffne ihn erneut. Die Einrichtung bleibt ausstehend, damit die Hinweise immer zu deiner verwendeten Version passen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the newer launcher and open it again. Setup stays pending so instructions always match the version you are using."
          }
        }
