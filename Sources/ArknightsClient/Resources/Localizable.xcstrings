            "state": "translated",
            "value": "Waiting for network…"
          }
        }
      }
    },
    "home.errorCode.accessibility": {
      "comment": "Accessibility label for a public troubleshooting code; first argument is the word and second is its space-separated spelling",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlercode %1$@, buchstabiert %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Error code %1$@, spelled %2$@"
          }
        }
      }
    },
