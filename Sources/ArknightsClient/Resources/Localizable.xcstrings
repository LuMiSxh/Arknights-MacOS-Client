    "onboarding.finish.downloading.detail": {
      "comment": "Finish panel detail while game download is active",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Abschließen der Einrichtung stoppt den Download nicht. Der Haupt-Launcher zeigt den Fortschritt an und aktiviert Spielen, sobald die Überprüfung abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finishing setup does not stop the download. The main launcher shows progress and enables Play when verification completes."
          }
        }
      }
    },
    "onboarding.finish.gameActive.detail": {
      "comment": "Finish panel detail while game is active",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe das Spiel mit Befehlstaste-Q, bevor du die Einrichtung abschließt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the game with Command-Q before finishing setup."
          }
        }
      }
    },
    "onboarding.finish.installed.detail": {
      "comment": "Finish panel detail while game is installed",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe die Einrichtung ab, um zum Launcher zurückzukehren und zu spielen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish setup to return to the launcher and start playing."
          }
        }
      }
    },
    "onboarding.finish.issue.detail": {
      "comment": "Problem report guidance",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Launcher, die Wine-Laufzeit oder der eingebettete Browser nicht richtig funktioniert, melde das bitte mit den erzeugten Diagnosedaten auf GitHub."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the launcher, Wine runtime, or embedded browser misbehaves, please report it on GitHub with the generated diagnostics."
          }
        }
      }
    },
    "onboarding.finish.paused.detail": {
      "comment": "Finish panel detail while installation is paused",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze den Download jetzt fort oder schließe die Einrichtung ab und fahre später im Haupt-Launcher fort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume the download now or finish setup and continue later from the main launcher."
